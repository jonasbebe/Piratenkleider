# Enforce consistent LF line endings across the repository.
# Prevents CRLF/LF mixing that produces spurious diffs (^M noise).
*.php  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.htm  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.svg  text eol=lf
*.po   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary files — never normalize
*.mo   binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
*.zip  binary
*.pld  binary
